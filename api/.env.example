PORT=8080

# Postgres on your VPS (required)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/flipur
# DATABASE_SSL=true

ADMIN_USER=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=long-random-string
CRM_INGEST_SECRET=change-me-chat-meta-ingest

# For npm run migrate:firestore (copy Firestore waitlist/CRM → Postgres)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/serviceAccount.json
# FIREBASE_PROJECT_ID=flipur-404bd

FLIPUR_SITE_ORIGIN=https://flipur.trade
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://flipur.trade,https://admin.flipur.trade

# Optional Dodo
