{
  "name": "flipur-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node -e \"import('dotenv/config'); import('./src/db.js').then(m => m.migrate().then(() => console.log('ok')).then(() => process.exit(0)))\"",
    "migrate:firestore": "node scripts/migrate-firestore-to-postgres.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dodopayments": "^1.14.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.6.0",
    "pg": "^8.13.3",
    "standardwebhooks": "^1.1.1"
  }
}
