rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function isAdmin() {
        return request.auth != null && request.auth.token.email == 'admin@flipur.trade';
      }
      function profile() {
        return request.resource.data.email == request.auth.token.email
          && request.resource.data.platform in ['topstepx', 'tradingview', 'both']
          && request.resource.data.displayName is string
          && request.resource.data.photoURL is string
          && request.resource.data.keys().hasAll(['email', 'displayName', 'photoURL', 'platform', 'createdAt']);
      }
      function statusOnCreate() {
        return !('status' in request.resource.data) || request.resource.data.status == 'waiting';
      }
      function statusOnUpdate() {
        return (!('status' in request.resource.data) && !('status' in resource.data))
          || (!('status' in resource.data) && request.resource.data.status == 'waiting')
          || ('status' in resource.data && request.resource.data.status == resource.data.status);
      }

      allow get: if isOwner() || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isOwner() && profile() && statusOnCreate());
      allow update: if isAdmin() || (isOwner() && profile() && statusOnUpdate());
      allow delete: if isAdmin();
    }
  }
}
