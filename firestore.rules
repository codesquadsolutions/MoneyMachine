rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@flipur.trade';
    }
    function isAffiliateOwner(affiliateId) {
      return request.auth != null && request.auth.uid == affiliateId;
    }

    match /waitlist/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function profile() {
        return request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string
          && request.resource.data.photoURL is string
          && request.resource.data.keys().hasAll(['email', 'displayName', 'photoURL', 'createdAt']);
      }
      function statusOnCreate() {
        return !('status' in request.resource.data) || request.resource.data.status == 'waiting';
      }
      function statusOnUpdate() {
        return (!('status' in request.resource.data) && !('status' in resource.data))
          || (!('status' in resource.data) && request.resource.data.status == 'waiting')
          || ('status' in resource.data && request.resource.data.status == resource.data.status);
      }

      allow get: if isOwner() || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isOwner() && profile() && statusOnCreate());
      allow update: if isAdmin() || (isOwner() && profile() && statusOnUpdate());
      allow delete: if isAdmin();
    }

    match /affiliateLeads/{leadId} {
      allow read, write: if false;
    }

    match /affiliates/{affiliateId} {
      allow get: if isAffiliateOwner(affiliateId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /affiliateCodes/{code} {
      allow read, write: if false;
    }

    match /affiliateConversions/{conversionId} {
      allow get: if isAdmin() || (request.auth != null && resource.data.affiliateId == request.auth.uid);
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /affiliateTickets/{ticketId} {
      allow get: if isAdmin() || (request.auth != null && resource.data.affiliateId == request.auth.uid);
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /affiliateStatsDaily/{docId} {
      allow read, write: if false;
    }

    match /webhookDedup/{docId} {
      allow read, write: if false;
    }
  }
}
