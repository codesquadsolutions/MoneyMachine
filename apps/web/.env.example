# Firebase console → Project settings → Your apps → Web app config.
# Enable Authentication (email for affiliates), Firestore.
# Authorized domains: localhost, flipur.trade, flipur-404bd.web.app — see docs/DOMAIN_CONNECT_FLIPUR_TRADE.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VPS / local API (replaces Cloud Functions)
VITE_API_BASE=http://localhost:8080
# Chrome Web Store (optional override; default is Flipur listing in src/content/download.js)
# VITE_CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/flipur-%E2%80%93-automated-trade/kdoalnknajmofjfcjblghjglihimncil
# Support chat widget → n8n Chat Trigger + Flipur engine UI (defaults in SupportChat.jsx)
# VITE_SUPPORT_CHAT_WEBHOOK_URL=https://n8n.codesquadsolutions.com/webhook/54827097-2aa9-4332-bf43-323b29c99b75/chat
# VITE_SUPPORT_CHAT_SDK_URL=/support-widget/engine-sdk.js
# Dodo customer portal (link on checkout success / support)
# VITE_DODO_CUSTOMER_PORTAL_URL=
# Analytics: paste full script src URL (e.g. Plausible or GA4 loader) — see main.jsx
# VITE_ANALYTICS_SCRIPT=
#
# Checkout on /pricing calls deployed Cloud Functions (createCheckoutSession).
# Sandbox: Dodo TEST API keys + test product IDs — see docs/LAUNCH_TRACK_A_AND_SANDBOX_B.md
