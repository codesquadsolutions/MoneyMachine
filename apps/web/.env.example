# Firebase console → Project settings → Your apps → Web app config.
# Also enable Authentication → Google, create a Firestore database,
# and authorize localhost plus your live domain.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: connect Cloud Functions emulator
# VITE_USE_FUNCTIONS_EMULATOR=true
# Chrome Web Store (optional override; default is Flipur listing in src/content/download.js)
# VITE_CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/flipur-%E2%80%93-automated-trade/kdoalnknajmofjfcjblghjglihimncil
