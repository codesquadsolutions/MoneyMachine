# Optional Firebase web config (admin Auth shell / legacy). Project: money-machine-247.
# Authorized domains: localhost, flipur.trade, money-machine-247.web.app — docs/DOMAIN_CONNECT_FLIPUR_TRADE.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Required for checkout / affiliates — VPS or local Express API (not Cloud Functions)
VITE_API_BASE=http://localhost:8080
# Production: VITE_API_BASE=https://api.flipur.trade
# Chrome Web Store (optional override; default in src/content/download.js)
# VITE_CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/flipur-%E2%80%93-automated-trade/kdoalnknajmofjfcjblghjglihimncil
